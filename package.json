{
  "name": "sdg17-partnership-hub",
  "version": "1.0.0",
  "description": "SDG 17 Partnership Hub — Partnerships for the Goals",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm --prefix client install && npm --prefix client run build",
    "vercel-build": "npm --prefix client install && npm --prefix client run build",
    "server": "npm --prefix server start",
    "server:dev": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "client:build": "npm --prefix client run build",
    "seed": "npm --prefix server run seed",
    "test:api": "node server/scripts/test-api.js",
    "install:all": "npm --prefix server install && npm --prefix client install"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5"
  },
  "keywords": [
    "sdg17",
    "un-goals",
    "mongodb",
    "express",
    "react",
    "nodejs",
    "partnership-hub"
  ],
  "author": "",
  "license": "ISC"
}
