# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection String
# Replace with your actual MongoDB Atlas connection string:
# Example: mongodb+srv://<username>:<password>@<cluster-url>/sdg17_hub?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://username:password@cluster0.mongodb.net/sdg17_hub?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=replace_with_a_secure_jwt_secret_key_minimum_32_characters
JWT_EXPIRES_IN=7d

# Allowed Client Origin for CORS
CLIENT_URL=http://localhost:5173
